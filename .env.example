# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# ---- LLM ----
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

# ---- Database ----
# PostgreSQL is required (SQLite is no longer supported as of this release).
# For local development, start Postgres via Docker:
#   docker compose up -d postgres
# Then set DATABASE_URL to your connection string.
DATABASE_URL=postgresql+psycopg2://paperchat:change-me@localhost:5432/paperchat
POSTGRES_USER=paperchat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paperchat

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333

# ---- Redis (optional locally; enables cross-instance rate limiting and
#      the "rq" background job backend) ----
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ---- Background jobs ----
# "inline" (default, uses FastAPI BackgroundTasks, no extra process needed)
# "rq" (requires REDIS_URL + a separate `rq worker paperchat` process)
JOB_BACKEND=inline

# ---- Auth / JWT ----
# Generate a real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed origins. "*" is fine for local dev only.
CORS_ORIGINS=*

# ---- Uploads ----
MAX_UPLOAD_MB=20

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Environment ----
ENVIRONMENT=development
LOG_LEVEL=INFO
